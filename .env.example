# Database configuration
DATABASE_URL="file:./dev.db"

# Instagram Credentials
IG_USERNAME=""
IG_PASSWORD=""
# Opsional: Jika akun terkena checkpoint / login block, Anda bisa isi cookie sessionid dari browser
IG_SESSIONID=""

# Operational Controls
BOT_PAUSED="false"
MIN_POST_DELAY_SECONDS=300
MAX_POST_DELAY_SECONDS=900
MAX_DAILY_POSTS=30

# Cloudflare Turnstile CAPTCHA (Optional in development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
    
# Security Salt for IP Hashing
RATE_LIMIT_SALT="menfess-secret-salt-random-key"