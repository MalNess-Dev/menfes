datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Menfess {
  id           Int       @id @default(autoincrement())
  recipient    String?
  sender       String?
  message      String
  status       String    @default("pending") // pending | processing | published | failed | rejected
  errorMessage String?
  retryCount   Int       @default(0)
  igMediaId    String?
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?
  slideCount   Int       @default(1)

  @@index([status])
  @@index([createdAt])
}

model IgSession {
  id          Int      @id @default(1)
  sessionData String
  updatedAt   DateTime @updatedAt
}

model BotStatus {
  id         Int       @id @default(1)
  isHalted   Boolean   @default(false)
  haltReason String?
  haltedAt   DateTime?
  updatedAt  DateTime  @updatedAt
}
